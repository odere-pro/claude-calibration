 import re

+def slugify(text):
+    """Lowercase, hyphenate, strip non-alphanumerics."""
+    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
+
 def is_slug(text):
     return bool(re.fullmatch(r"[a-z0-9-]+", text))
