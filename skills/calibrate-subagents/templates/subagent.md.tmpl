model: sonnet                  # explicit: haiku (narrow), sonnet (orchestration), opus (deep reasoning)
# disallowedTools: <Tool>      # alternative when you want "inherit all except X"
# permissionMode: default      # default | acceptEdits | auto | dontAsk | bypassPermissions | plan
