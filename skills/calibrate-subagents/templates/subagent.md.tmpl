# maxTurns: 30                 # cap on agentic turns before the agent stops
# skills: [name1, name2]       # preload these skills' full content at startup
                               #   (does not work with disable-model-invocation: true skills)
# mcpServers:                  # subagent-only MCP servers — keeps their tool descriptions out of
#   server-name:               # the main conversation
#     command: ...
# hooks:                       # lifecycle hooks scoped to this subagent (ignored for plugin agents)
# memory: project              # user | project | local — cross-session auto memory for this agent
# isolation: worktree          # run in a temporary git worktree (auto-cleaned if no changes)
# background: true             # always run as a background task
# effort: low                  # effort override (low..max, model-dependent)
